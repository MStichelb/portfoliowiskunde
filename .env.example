# Lokale ontwikkeling
ADMIN_PASSWORD=vervang-door-een-lang-uniek-wachtwoord
ADMIN_SESSION_SECRET=vervang-door-een-aparte-sleutel-van-minstens-32-tekens
PORTFOLIO_SOURCE_PATH=C:\pad\naar\de\lokale\testmap
# PORTFOLIO_DATABASE_PATH=C:\pad\naar\portfolio.db

# Productiedatabase (verplicht in production; PostgreSQL)
# DATABASE_URL=postgresql://gebruiker:wachtwoord@host:5432/database?sslmode=require

# Microsoft Entra / OneDrive (verplicht voor OneDrive)
# MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_CLIENT_SECRET=kopieer-de-secret-alleen-naar-de-environment
# MICROSOFT_REDIRECT_URI=http://localhost:3000/api/onedrive/callback
# GRAPH_TOKEN_ENCRYPTION_KEY=base64-gecodeerde-sleutel-van-exact-32-bytes

# Optionele productie-instellingen
# REPORT_RATE_LIMIT_SECRET=aparte-lange-willekeurige-sleutel
# PORTFOLIO_AUTO_SYNC_TTL_SECONDS=180
# PORTFOLIO_SYNC_LEASE_SECONDS=600

# Alleen voor optionele libSQL/Turso-ontwikkeling, niet voor Vercel-productie
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...
# DATABASE_AUTH_TOKEN=...
